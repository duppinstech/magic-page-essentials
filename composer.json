{
    "name": "duppinstech/magic-page-essentials",
    "description": "WordPress plugin (use composer only for dev/vendor; site installs use bundled vendor).",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4",
        "yahnis-elsts/plugin-update-checker": "5"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "lint": "@php scripts/lint.php",
        "test": "@php vendor/bin/phpunit -c phpunit.xml.dist"
    }
}
